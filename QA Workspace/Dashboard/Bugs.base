filters:
  and:
    - file.hasTag("bug")
    - file.ext == "md"
formulas:
  status_icone: if(status == "resolvido", "✅", if(status == "em_validacao", "🟡", if(status == "aberto", "🔴", if(status == "descartado", "🗑️", "⚪"))))
  prioridade_icone: if(prioridade == "altíssima", "🔴", if(prioridade == "critica", "🔴", if(prioridade == "alta", "🟠", if(prioridade == "media", "🟡", if(prioridade == "baixa", "🟢", "⚪")))))
  dias_aberto: if(status == "aberto", if(data_inicio, (today() - date(data_inicio)).days, ""), "")
  pontos_faixa: if(pontos == null, "", if(pontos == 0, "< 0,5h", if(pontos == 1, "< 2h", if(pontos == 2, "< 4h", if(pontos == 3, "< 8h", if(pontos == 5, "< 2d", if(pontos == 8, "< 3d", if(pontos == 13, "< 4d", if(pontos == 21, "< 5d", if(pontos == 34, "< 7d", if(pontos == 55, "< 10d", if(pontos == 89, "< 15d", if(pontos == 144, "< 30d", "?")))))))))))))
properties:
  ambiente:
    displayName: Ambiente
  modulo:
    displayName: Módulo
  responsavel:
    displayName: Responsável
  aguardando:
    displayName: Aguardando
  formula.status_icone:
    displayName: Status
  formula.prioridade_icone:
    displayName: Prioridade
  formula.dias_aberto:
    displayName: Dias aberto
  pontos:
    displayName: Pontos
  formula.pontos_faixa:
    displayName: Faixa
views:
  - type: table
    name: Bugs Abertos
    filters:
      and:
        - status == "aberto"
    order:
      - file.name
      - formula.prioridade_icone
      - formula.dias_aberto
      - ambiente
      - modulo
    sort:
      - property: formula.prioridade_icone
        direction: DESC
      - property: formula.dias_aberto
        direction: DESC
  - type: table
    name: Todos os Bugs
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - formula.status_icone
      - formula.prioridade_icone
      - ambiente
      - modulo
  - type: table
    name: Bugs por Ambiente
    groupBy:
      property: ambiente
      direction: ASC
    order:
      - file.name
      - formula.status_icone
      - formula.prioridade_icone
      - modulo
  - type: table
    name: Bugs por Módulo
    groupBy:
      property: modulo
      direction: ASC
    order:
      - file.name
      - formula.status_icone
      - formula.prioridade_icone
      - ambiente
